{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>woodleighschool/renovate-config"],
  // The central regeneration workflow commits compiled gh-aw output as Woodmin.
  gitIgnoredAuthors: ["225126206+woodmin[bot]@users.noreply.github.com"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  // Read action references from the gh-aw source, not its generated YAML.
  "github-actions": {
    managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.md$/"],
  },
  packageRules: [
    {
      description: "Compiled Agentic Workflows",
      matchFileNames: [".github/workflows/*.lock.yml"],
      enabled: false,
    },
    {
      description: "Agentic Workflow Actions",
      matchManagers: ["github-actions"],
      matchFileNames: [".github/workflows/*.md"],
      // The compiler pins these tags to digests.
      pinDigests: false,
    },
    {
      description: "Stemma Group",
      matchPackageNames: ["woodleighschool/stemma", "github.com/woodleighschool/stemma"],
      groupName: "Stemma",
      // One upgrade per pin: the publish action, the Mise tool and the plugin module.
      minimumGroupSize: 3,
      minimumReleaseAge: null,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Stemma Plugin Images",
      managerFilePatterns: ["/(^|/)stemma\\.yaml$/"],
      matchStrings: [
        "image:\\s*[\"']?(?<depName>[^\\s\"'@]+):(?<currentValue>[^\\s\"'@:/]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
